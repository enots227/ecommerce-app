{
  "kind": "collectionType",
  "collectionName": "book_editions",
  "info": {
    "singularName": "book-edition",
    "pluralName": "book-editions",
    "displayName": "BookEdition"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "book": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::book.book",
      "inversedBy": "editions"
    },
    "name": {
      "type": "string"
    },
    "releasedAt": {
      "type": "date"
    },
    "skus": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::book-sku.book-sku",
      "mappedBy": "edition"
    }
  }
}
