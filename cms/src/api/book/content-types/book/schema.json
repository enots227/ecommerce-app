{
  "kind": "collectionType",
  "collectionName": "books",
  "info": {
    "singularName": "book",
    "pluralName": "books",
    "displayName": "Book"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "slug": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": false
        }
      },
      "required": true,
      "unique": true,
      "regex": "^[A-Za-z0-9_-]+$"
    },
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true
    },
    "authors": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::author.author",
      "mappedBy": "books"
    },
    "editions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::book-edition.book-edition",
      "mappedBy": "book"
    },
    "stockKeepingUnits": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::book-sku.book-sku",
      "mappedBy": "book"
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::book-category.book-category",
      "mappedBy": "books"
    }
  }
}
