{
  "kind": "collectionType",
  "collectionName": "book_categories",
  "info": {
    "singularName": "book-category",
    "pluralName": "book-categories",
    "displayName": "BookCategory"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "books": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::book.book",
      "inversedBy": "categories"
    },
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true,
      "unique": true
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "catalog": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::catalog.catalog",
      "required": true
    }
  }
}
