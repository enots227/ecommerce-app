{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.5/.schema/devbox.schema.json",
  "packages": ["nodejs@24", "docker@latest", "nest-cli@11"],
  "env": {
    "COMPOSE_ENV_FILES": "$DEVBOX_PROJECT_ROOT/.env.docker"
  },
  "shell": {
    "init_hook": ["cd ./ui && npm install"],
    "scripts": {
      "start:ui": "cd ./ui && npm run dev"
    }
  }
}
